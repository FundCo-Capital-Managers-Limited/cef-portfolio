          <mxGeometry x="580" y="620" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s12" value="Nightly Reconciliation (+ lazy per-AssetCo trigger&#10;on first event of the day, + manual &quot;Run now&quot;)&#10;calls back into AssetCo's /cef/assets,/payments,/faults&#10;catches anything a missed/failed handler dropped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#784212;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="280" y="720" width="500" height="90" as="geometry" />
