          <mxGeometry x="880" y="420" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="Alert Engine&#10;asset.fault.detected / payment.defaulted&#10;describeCustomerAndAsset() — human-readable&#10;messages (name + asset type, not raw IDs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2874A6;strokeColor=none;fontColor=#FFFFFF;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="1140" y="420" width="280" height="80" as="geometry" />
