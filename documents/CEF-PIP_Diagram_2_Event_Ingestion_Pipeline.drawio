        <mxCell id="title" value="CEF-PIP — Event Ingestion Pipeline" style="text;html=1;align=center;fontSize=26;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="500" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Store first, process second — a processing failure never blocks the AssetCo's webhook response" style="text;html=1;align=center;fontSize=12;fontStyle=2;fontColor=#AAB7B8;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="380" y="60" width="840" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s0" value="AssetCo platform&#10;POST /api/v1/events&#10;+ X-CEF-AssetCo-Id&#10;+ X-CEF-Signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#922B21;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="140" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="verifyHmac middleware&#10;HMAC-SHA256 over raw body&#10;vs assetcos.hmac_secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="140" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s1fail" value="401 Invalid signature&#10;(request rejected, nothing stored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B241C;strokeColor=none;fontColor=#FFFFFF;fontSize=10;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="250" width="220" height="45" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="eventSchema.js&#10;validate payload shape&#10;against the 14 CIS event types" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="600" y="140" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s2fail" value="400 Bad Request&#10;(malformed / unknown event)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B241C;strokeColor=none;fontColor=#FFFFFF;fontSize=10;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="600" y="250" width="220" height="45" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="events table&#10;durable raw log&#10;— always written first, regardless of what happens next" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#117864;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="880" y="140" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="200 { status: accepted, eventId }&#10;returned to AssetCo immediately" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#196F3D;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1180" y="140" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="eventProcessor.js&#10;dispatches to handler by eventType&#10;(async, after response already sent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#34495E;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="880" y="290" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="registryStubs.js&#10;upserts placeholder asset/customer row&#10;if payment/fault event arrives before *.created&#10;(out-of-order delivery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7D6608;strokeColor=none;fontColor=#FFFFFF;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="580" y="420" width="260" height="90" as="geometry" />
        </mxCell>

