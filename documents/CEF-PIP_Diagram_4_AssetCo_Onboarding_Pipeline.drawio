        <!-- Pipeline board note -->
        <mxCell id="pipe" value="Pipeline Board (dashboard/app/dashboard/pipeline) shows every AssetCo's current stage as a kanban-style board.&#10;AdvanceStageButton lets it_admin/management move an AssetCo forward — each transition is written to audit_log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#34495E;strokeColor=none;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="230" width="1630" height="55" as="geometry" />
        </mxCell>

        <!-- People/roles involved -->
