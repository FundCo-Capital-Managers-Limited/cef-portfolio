        <mxCell id="en4" value="SUSPENDED&#10;(off-ramp, any stage → here on issue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B241C;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="640" y="480" width="260" height="40" as="geometry" /></mxCell>

        <!-- InfraCredit/DREEF/CEF Series note -->
        <mxCell id="misc" value="Alongside pipeline stage, an AssetCo also tracks (mid-sprint additions): InfraCredit/DREEF guarantee status (DREEF Pipeline page),&#10;CEF Series funding round allocation (CEF Series page), and its own CEF Facility Repayment loan book entries (Loan Book page)&#10;— these are independent tracks layered on top of the same assetcos row, not sub-stages of onboarding." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#34495E;strokeColor=none;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="560" width="1630" height="70" as="geometry" />
        </mxCell>

