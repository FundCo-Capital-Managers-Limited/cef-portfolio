        <mxCell id="p2" value="CEF executive/management&#10;approves/rejects, advances pipeline stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#196F3D;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="310" y="350" width="270" height="55" as="geometry" /></mxCell>
        <mxCell id="p3" value="CEF it_admin&#10;creates assetco_admin / assetco_dev accounts,&#10;can manually re-run reconciliation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#196F3D;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="620" y="350" width="270" height="55" as="geometry" /></mxCell>
        <mxCell id="p4" value="AssetCo Developer (assetco_dev)&#10;builds/tests integration, self-service&#10;regenerates own HMAC secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7950B;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="930" y="350" width="270" height="55" as="geometry" /></mxCell>
        <mxCell id="p5" value="AssetCo Admin (assetco_admin)&#10;monitors their own AssetCo's dashboard&#10;once live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7950B;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" parent="1" vertex="1"><mxGeometry x="1240" y="350" width="270" height="55" as="geometry" /></mxCell>

