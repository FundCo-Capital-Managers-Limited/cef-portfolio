PORT=4000
NODE_ENV=development

# Supabase — secret key only. Never put a publishable/anon key here; the backend
# doesn't need it, and this file (unlike .env) may end up read by more people.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional — defaults to {SUPABASE_URL}/auth/v1/.well-known/jwks.json. Used to verify
# dashboard-user session JWTs on manual-entry/facility/pipeline-stage endpoints.
SUPABASE_JWKS_URL=

# Browser origins allowed to call this API (comma-separated, exact match —
# e.g. https://cef-pip.vercel.app,https://cef-pip-staging.vercel.app).
# Leave empty for local dev. Every deployed environment (Render) should set
# this to its corresponding Vercel URL(s) — see ENVIRONMENTS.md.
CORS_ALLOWED_ORIGINS=

# Resend (email alerts + password reset)
RESEND_API_KEY=
ALERT_RECIPIENT_EMAILS=cef-team@example.com

# Where the dashboard is served — used to build the password-reset redirect link.
FRONTEND_URL=http://localhost:3000
# Comma-separated allowlist: while still testing on dev, only these addresses
# actually receive a reset email (the request still "succeeds" either way).
# Leave empty once ready for every real account to receive reset emails.
PASSWORD_RESET_ALLOWED_RECIPIENTS=

# Reconciliation
RECONCILIATION_CRON=0 2 * * *
# Guards POST /internal/reconciliation/run (manual trigger for demos/testing —
# the Render Cron Job calls the script directly and doesn't need this).
INTERNAL_TRIGGER_TOKEN=

# Explicit opt-in for DELETE /api/v1/sandbox/reset — always refused when
# NODE_ENV=production regardless of this flag, but every other environment
# (including this one, local dev) is disabled by default until set to
# "true". Set this on cef-pip-api-staging (never on the real prod service).
SANDBOX_RESET_ENABLED=
