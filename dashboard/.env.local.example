NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Express API base URL — used for role-gated writes (pipeline stage changes,
# manual entry, facility management) that need server-side validation + audit
# logging. Reads still go straight to Supabase via RLS, as before.
NEXT_PUBLIC_API_URL=http://localhost:4000
# This deployment's own public URL — used to resolve absolute URLs for SEO
# metadata (Open Graph images, sitemap, robots.txt). Set to the real Vercel
# URL in each environment; defaults to localhost for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
